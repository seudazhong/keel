# Copy to .env and adjust. Compose reads this root file for variable
# substitution; services also read KEEL_* env vars at runtime. The CLI and
# services also load this file into the process environment at startup, so the
# provider keys below (read by LiteLLM) work from here too — real environment
# variables always take precedence.
KEEL_APP_ENV=dev
KEEL_LOG_LEVEL=INFO

# Event store backend: "postgres" (default, durable) or "memory" (single-process).
# Use "memory" to run the server on a Windows host, where uvicorn's Proactor loop
# can't drive psycopg's async driver (Postgres durability is a Docker/Linux concern).
# KEEL_EVENT_STORE=postgres

# Default model surfaces use when --model is omitted (any LiteLLM model id).
KEEL_DEFAULT_MODEL=gpt-4o-mini

# Provider API keys — set the one(s) for the model you use (read by LiteLLM):
#   OpenAI     gpt-4o-mini                          -> OPENAI_API_KEY
#   Anthropic  anthropic/claude-3-5-sonnet-latest   -> ANTHROPIC_API_KEY
#   Gemini     gemini/gemini-1.5-pro                -> GEMINI_API_KEY
#   DeepSeek   deepseek/deepseek-chat               -> DEEPSEEK_API_KEY
#   Azure      azure/<deployment>                   -> AZURE_API_KEY + AZURE_API_BASE + AZURE_API_VERSION
#   Ollama     ollama/llama3                        -> (no key; local)
#   Copilot    github_copilot/claude-sonnet-4.5     -> (no key; browser device-login on first run)
# GitHub Copilot: use a chat-capable model (claude-*, gpt-4o, gpt-4.1, gemini-3.x).
# Responses-only ids (e.g. gpt-5.3-codex) are auto-routed through LiteLLM's /responses
# endpoint by the gateway; other models use /chat/completions.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# DEEPSEEK_API_KEY=...

# Connector token encryption (G18) — any passphrase; a Fernet key is derived.
# Empty -> the connector token store fails closed. The host authorize script and the
# worker MUST share the same value (the Fernet key is derived deterministically).
# KEEL_SECRET_KEY=change-me
# Key rotation (M3.3): register versioned keys as id:secret pairs and pick the active
# id for new writes. Keep every historical id listed until rows are re-encrypted
# (PostgresTokenStore.reencrypt_stale). A legacy KEEL_SECRET_KEY stays valid as id "v1".
# KEEL_SECRET_KEYS=v1:old-passphrase,v2:new-passphrase
# KEEL_SECRET_KEY_ACTIVE_ID=v2

# Cloud-safety posture (M3.3). Set to 1 for any internet-exposed / multi-tenant deploy:
# the server then fails CLOSED — an empty KEEL_API_KEYS rejects every request instead of
# the local implicit-admin open mode, and IM webhooks REQUIRE a signing secret. Leave
# unset/0 for local single-user use.
# KEEL_CLOUD_MODE=0

# RBAC (B3): comma-separated key:role pairs (roles: viewer|operator|admin). Keys are
# hashed at rest and verified in constant time. Empty -> open mode (local only; rejected
# when KEEL_CLOUD_MODE=1).
# KEEL_API_KEYS=s3cret-admin-key:admin,readonly-key:viewer

# Identity / OIDC (M3.6). Human users authenticate with an OIDC bearer JWT verified against
# the issuer's JWKS (issuer/audience/exp/nbf/iat, asymmetric algorithms only). Enable and
# configure the issuer, audience (comma-separated), and JWKS URL (https). A verified user
# selects an org via the X-Keel-Org header. See docs/IDENTITY.md.
# KEEL_OIDC_ENABLED=1
# KEEL_OIDC_ISSUER=https://issuer.example.com
# KEEL_OIDC_AUDIENCE=keel
# KEEL_OIDC_JWKS_URI=https://issuer.example.com/.well-known/jwks.json
# Expected authorized party; a multi-audience token's azp must equal it (defaults to the
# single audience above when only one is configured).
# KEEL_OIDC_CLIENT_ID=keel
# KEEL_OIDC_LEEWAY_SECONDS=60
# KEEL_OIDC_JWKS_CACHE_TTL_SECONDS=3600
# Minimum seconds between unknown-kid JWKS refreshes (anti-amplification).
# KEEL_OIDC_JWKS_MIN_REFRESH_INTERVAL_SECONDS=60
# JIT-provision a first-seen verified subject a durable user (default off = explicit link).
# KEEL_IDENTITY_ALLOW_JIT_PROVISIONING=0
# OAuth CSRF state lifetime (seconds) for the in-browser connect flow.
# KEEL_OAUTH_STATE_TTL_SECONDS=600
# Webhook replay-protection / idempotency retention window (seconds).
# KEEL_WEBHOOK_REPLAY_TTL_SECONDS=86400

# Gmail read connector (WS-G) — set enabled=1 and run scripts/gmail_authorize.py once
# (needs KEEL_SECRET_KEY + a Desktop OAuth client saved at the path below). Default
# off -> the digest uses the fake in-memory inbox.
# KEEL_GMAIL_ENABLED=0
# KEEL_GMAIL_CLIENT_SECRETS_PATH=.secrets/gmail_client.json
# KEEL_GMAIL_MAX_MESSAGES=5
# Real outbound send (gmail.send). Off even when reading is on -> send stays mocked +
# approval-gated. Turning it on requires re-running gmail_authorize.py (send scope).
# KEEL_GMAIL_SEND_ENABLED=0

# Langfuse tracing (WS-H) — set both keys to enable; otherwise tracing is a no-op.
# KEEL_LANGFUSE_PUBLIC_KEY=pk-lf-...
# KEEL_LANGFUSE_SECRET_KEY=sk-lf-...
# KEEL_LANGFUSE_HOST=https://cloud.langfuse.com

# OneBot (QQ) IM gateway (WS-E/J) — set the HTTP API base to enable. The bot posts
# events to POST /v1/gateway/onebot; replies go back via this API. Untrusted surface:
# runs use the safe (read-only) toolset only. Set a signing secret so inbound events are
# HMAC-SHA1 verified (required when KEEL_CLOUD_MODE=1) + durably replay-protected.
# KEEL_ONEBOT_API_BASE=http://127.0.0.1:5700
# KEEL_ONEBOT_ACCESS_TOKEN=
# KEEL_ONEBOT_SELF_ID=10000
# KEEL_ONEBOT_SIGNING_SECRET=
# KEEL_IM_RATE_LIMIT=5

# Telegram IM gateway (WS-E/J). Set a webhook secret and register it with setWebhook so
# the X-Telegram-Bot-Api-Secret-Token header is verified before dispatch (required when
# KEEL_CLOUD_MODE=1). Updates are de-duplicated by update_id (durable replay protection).
# KEEL_TELEGRAM_BOT_TOKEN=
# KEEL_TELEGRAM_BOT_USERNAME=
# KEEL_TELEGRAM_WEBHOOK_SECRET=

# Host-side values (for running a service OUTSIDE compose). Inside compose the
# service environment overrides these to use the postgres/redis service names.
KEEL_DATABASE_URL=postgresql+psycopg://keel:keel@localhost:5432/keel
KEEL_REDIS_URL=redis://localhost:6379/0
KEEL_SERVER_HOST=0.0.0.0
KEEL_SERVER_PORT=8000

# Command/file execution uses authenticated sandbox RPC by default. Use a random
# secret of at least 32 bytes and configure the same value on keel-sandbox.
KEEL_EXECUTION_BACKEND=sandbox
KEEL_SANDBOX_URL=http://127.0.0.1:8090
KEEL_SANDBOX_RPC_SECRET=
KEEL_SANDBOX_RPC_LOCAL_TEST_MODE=false

# Executor-only assertions. Enable only when the container mounts solely a
# workspace already stripped of .git/.env and enforces the admitted egress policy.
KEEL_SANDBOX_HOST=127.0.0.1
KEEL_SANDBOX_ISOLATION_VERIFIED=false
KEEL_SANDBOX_WORKSPACE_SANITIZED=false
