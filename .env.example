# Copy to .env and adjust. Compose reads this root file for variable
# substitution; services also read KEEL_* env vars at runtime.
KEEL_APP_ENV=dev
KEEL_LOG_LEVEL=INFO

# Host-side values (for running a service OUTSIDE compose). Inside compose the
# service environment overrides these to use the postgres/redis service names.
KEEL_DATABASE_URL=postgresql+psycopg://keel:keel@localhost:5432/keel
KEEL_REDIS_URL=redis://localhost:6379/0
KEEL_SERVER_HOST=0.0.0.0
KEEL_SERVER_PORT=8000
